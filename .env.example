# Bundesagentur fuer Arbeit Portal Credentials (optional for public REST API search/export)
BA_USERNAME=
BA_PASSWORD=
BA_TOTP_SECRET=

# Optional IMAP fallback for email OTP codes
BA_IMAP_HOST=
BA_IMAP_PORT=993
BA_IMAP_USER=
BA_IMAP_PASSWORD=
BA_IMAP_FOLDER=INBOX

# Local storage and export paths
JOBSUCHE_DB_PATH=data/jobsuche.db
JOBSUCHE_EXPORT_DIR=exports
JOBSUCHE_STORAGE_STATE=data/storage_state.json
JOBSUCHE_SCREENSHOT_DIR=data/screenshots

# Search & REST API defaults
JOBSUCHE_DEFAULT_WAS=Fachinformatiker/in für Systemintegration
JOBSUCHE_DEFAULT_CITY=Aachen
JOBSUCHE_DEFAULT_RADIUS=25
JOBSUCHE_DEFAULT_ANGEBOTSART=4
JOBSUCHE_API_BASE_URL=https://rest.arbeitsagentur.de/jobboerse/jobsuche-service
JOBSUCHE_API_KEY=jobboerse-jobsuche

# Browser automation settings
BROWSER_EXECUTABLE_PATH=
BROWSER_CDP_URL=
HEADLESS=true
